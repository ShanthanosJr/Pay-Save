# Local dev only. Copy to .env. Generate real secrets with: openssl rand -base64 32
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://payandsave:payandsave@localhost:5432/payandsave
JWT_ACCESS_SECRET=b93aac47a1f354d9f20925e01fd618968501cea2145509f2525afd0219f15423
JWT_REFRESH_SECRET=293d8123d0d103b906049d9fd64f0a3e412a5ef18cd6d7ae0cd67f64b3e77481
PII_ENCRYPTION_KEY=hC2QZJApkyg0jNgWrQne24JawjFeer+Lml4cJnBgmO4=
PII_HMAC_KEY=g2UeLrj0otwr5FvcaloS12sqj9set9yQoyfsKyQRCw8=

# --- SMS (one-time codes, reminders) ---
# console prints messages to the server log (development only; refused in production).
# notifylk | textlk are Sri Lankan gateways; twilio works anywhere.
SMS_PROVIDER=console
# SMS_SENDER_ID=PayAndSave        # approved sender id (notifylk, textlk)
# NOTIFYLK_USER_ID=
# NOTIFYLK_API_KEY=
# TEXTLK_API_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# --- Email (verification, password reset, reminders) ---
# smtp works with any relay: Amazon SES, Brevo, Mailgun, Gmail with an app password.
EMAIL_PROVIDER=console
# EMAIL_FROM="Pay&Save <no-reply@yourdomain.lk>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Public address of this API, printed on statements as the verify link (https in production).
PUBLIC_BASE_URL=http://localhost:3000

# Returns the code in the API response so the app can show it. Development only.
DEV_OTP_ECHO=true
CORS_ORIGINS=*
