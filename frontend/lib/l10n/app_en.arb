  "welcomeTitleLine2": "Save Together.",
  "@welcomeTitleLine2": { "description": "Second line of the Welcome screen headline." },

  "welcomeSubtitle": "Keep your seettu records clear for everyone",
  "@welcomeSubtitle": { "description": "Welcome screen subtitle under the headline." },

  "languageEnglish": "English",
  "@languageEnglish": { "description": "Language chip label, always shown in English regardless of the current locale." },

  "languageSinhala": "සිංහල",
  "@languageSinhala": { "description": "Language chip label, always shown in Sinhala regardless of the current locale." },

  "languageTamil": "தமிழ்",
  "@languageTamil": { "description": "Language chip label, always shown in Tamil regardless of the current locale." },

