    "description": "Home screen greeting.",
    "placeholders": { "name": { "type": "String", "example": "Nadeeshi" } }
  },

  "searchHint": "Find a payment or circle",
  "@searchHint": { "description": "Placeholder text in the home search field." },

  "thisCycle": "This cycle",
